{
  "name": "@timepp/uu",
  "version": "1.0.36",
  "license": "MIT",
  "tasks": {
    "test": "deno test",
    "clean": "rm -rf dist",
    "build": "deno task clean && tsc --noCheck",
    "build:bundle": "esbuild src/uu.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/uu.bundle.js",
    "build:all": "deno task build && deno task build:bundle",
    "prepublishOnly": "deno task build:all",
    "ui-test": "cd ui-test && vite --open",
    "incver": "deno run -A script/increase-ver.ts"
  },
  "exports": {
    ".": "./src/uu.ts",
    "./cdn": "./src/uu-cdn.ts",
    "./tu": "./src/tu.ts",
    "./deno": "./src/tu-deno.ts"
  },
  "imports": {
    "@codemirror/lang-json": "npm:@codemirror/lang-json@6.0.2",
    "@codemirror/language": "npm:@codemirror/language@6.12.4",
    "@codemirror/search": "npm:@codemirror/search@6.7.2",
    "@codemirror/state": "npm:@codemirror/state@6.7.4",
    "@codemirror/view": "npm:@codemirror/view@6.43.11",
    "chart.js/auto": "npm:chart.js@4.5.1/auto",
    "markdown-it": "npm:markdown-it@15.0.1"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable",
      "node",
      "dom"
    ]
  }
}